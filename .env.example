# Copy to .env for local development. In production set these as host secrets
# (e.g. `fly secrets set ...`) rather than committing a file.

# --- Twilio ---
# Console home page -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used to validate the X-Twilio-Signature header on inbound webhooks. Required
# in production: the server refuses to start without it.
TWILIO_AUTH_TOKEN=your_auth_token
# The SMS-capable number you bought, E.164 format
TWILIO_SMS_NUMBER=+15551234567
# WhatsApp sender: the sandbox number is +14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Server ---
# Public origin of the deployment, no trailing slash. Twilio signs the exact
# URL it calls, so this must match what is configured in the Twilio Console.
PUBLIC_URL=https://mindchuk.example.com
PORT=3000
# Set to "production" on the host. Enables mandatory signature validation and
# the dashboard auth gate.
NODE_ENV=development

# --- Storage ---
# Directory holding notes.md and tags.json. Point this at a mounted volume in
# production (e.g. /data on Fly.io) so notes survive redeploys.
DATA_DIR=./data

# --- Dashboard / API auth ---
# HTTP basic auth for the dashboard and /api. DASHBOARD_PASSWORD is required in
# production. Scripts can send the same value as an "x-dashboard-secret" header.
DASHBOARD_USER=mindchuk
DASHBOARD_PASSWORD=change_me

# --- Optional ---
# Inbound webhook requests allowed per minute per IP (default 30)
WEBHOOK_RATE_LIMIT=30
# Local-only escape hatch to accept unsigned webhook posts (curl testing).
# Ignored — and rejected at startup — when NODE_ENV=production.
SKIP_TWILIO_VALIDATION=false
